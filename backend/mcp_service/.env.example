# 服务基本信息
SERVICE_ROLE=mcp_server
APP_ENV=development
## 端口信息
PORT=3090

# 微服务通讯
## 内部服务鉴权
INTERNAL_API_SECRET=
## 主服务地址
MAIN_SERVICE_URL=http://localhost:9090
## 超时时间, 默认30s
RPC_TIMEOUT=30

# 缓存
## 缓存后端
CACHE_BACKEND=mem
## 缓存过期时间, 默认15分钟
CACHE_TTL=900

# Browser origins allowed to call MCP. Staging/production must use an explicit
# comma-separated allowlist; wildcard and empty values are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
